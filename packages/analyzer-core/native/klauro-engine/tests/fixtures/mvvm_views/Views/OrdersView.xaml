<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Shop.App.ViewModels"
             x:Class="Shop.App.Views.OrdersView"
             x:DataType="viewmodels:OrdersViewModel">
    <Button Text="Cancel" Command="{Binding CancelOrderCommand}" />
    <Button Text="Refresh" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:OrdersViewModel}}, Path=RefreshCommand}" />
    <Label Text="{Binding Title}" />
</ContentPage>
