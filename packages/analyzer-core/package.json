{
  "name": "@klauro/analyzer-core",
  "version": "1.0.0",
  "private": true,
  "description": "Klauro CAS analyzer engine and legacy API shell kept for analyzer compatibility.",
  "main": "index.js",
  "scripts": {
    "dev": "nest start --watch",
    "dev:legacy": "nodemon --exec ts-node src/index.ts",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "test": "npm run test:jest && npm run test:node",
    "test:jest": "jest",
    "test:node": "node --require ts-node/register/transpile-only --test \"src/analyzer/**/*.test.ts\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "mikro-orm migration:create",
    "migrate:up": "mikro-orm migration:up",
    "migrate:down": "mikro-orm migration:down",
    "migrate:status": "mikro-orm migration:list",
    "migrate:generate": "mikro-orm migration:create --blank",
    "schema:drop": "mikro-orm schema:drop --run",
    "schema:create": "mikro-orm schema:create --run",
    "schema:update": "mikro-orm schema:update --run"
  },
