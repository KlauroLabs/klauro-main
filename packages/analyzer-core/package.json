{
  "name": "@klauro/analyzer-core",
  "version": "1.0.0",
  "private": true,
  "description": "Klauro CAS analyzer engine.",
  "main": "dist/analyzer/index.js",
  "scripts": {
    "postinstall": "node scripts/verify-native-parser.cjs",
    "build": "tsc -p tsconfig.json",
    "unused-code": "node ../../scripts/remove-unused-locals.mjs tsconfig.json",
    "unused-code:fix": "node ../../scripts/remove-unused-locals.mjs tsconfig.json --write",
    "test": "npm run test:jest && npm run test:node",
    "test:jest": "jest",
    "test:node": "node --require ts-node/register/transpile-only --test \"src/analyzer/**/*.test.ts\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "parity:extractor": "node --require ts-node/register/transpile-only src/__tests__/parity/run-extractor-parity.ts",
    "parity:extractor:jest": "jest --config jest.parity.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0 <27.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.62.0",
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "@huggingface/inference": "^4.8.0",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/parser": "^8.43.0",
    "@typescript-eslint/typescript-estree": "^8.43.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "axios": "^1.18.1",
    "dotenv": "^16.4.5",
    "escodegen": "^2.1.0",
    "espree": "^10.4.0",
    "estraverse": "^5.3.0",
    "fast-xml-parser": "^5.10.1",
    "fs-extra": "^11.3.1",
    "glob": "^11.0.3",
    "handlebars": "^4.7.9",
    "ioredis": "^5.7.0",
    "isomorphic-dompurify": "^2.9.0",
    "joi": "^17.11.0",
    "js-yaml": "^5.2.3",
    "openai": "^5.20.1",
    "p-limit": "^3.1.0",
    "p-retry": "^4.6.2",
    "pg": "^8.11.3",
    "pg-pool": "^3.6.2",
    "tree-sitter": "^0.25.0",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-wasms": "^0.1.11",
    "validator": "^13.15.35",
    "web-tree-sitter": "^0.22.6",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.10.9",
    "@types/validator": "^13.15.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
