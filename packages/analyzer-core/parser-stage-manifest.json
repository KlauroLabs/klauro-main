{
  "version": 2,
  "parser": {
    "directories": [
      {
        "path": "native/klauro-engine/src",
        "extensions": [
          ".rs"
        ]
      },
      {
        "path": "native/klauro-engine/data",
        "extensions": [
          ".tsv"
        ]
      },
      {
        "path": "native/klauro-engine/grammars",
        "extensions": [
          ".c",
          ".h"
        ]
      }
    ],
    "files": [
      "parser-stage-manifest.json",
      "native/klauro-engine/Cargo.toml",
      "native/klauro-engine/Cargo.lock",
      "native/klauro-engine/build.rs"
    ]
  },
  "derived": {
    "directories": [
      {
        "path": "src/analyzer/tier-stack",
        "extensions": [
          ".ts"
        ]
      }
    ],
    "files": [
      "src/types/cas.types.ts",
      "src/analyzer/core/build-artifact-paths.ts",
      "src/analyzer/core/codebase-type.ts",
      "src/analyzer/core/communication-seams.ts",
      "src/analyzer/core/consistency-model.ts",
      "src/analyzer/core/conventions-applier.ts",
      "src/analyzer/core/event-loop-yield.ts",
      "src/analyzer/core/glob-cache.ts",
      "src/analyzer/core/graph-validation.ts",
      "src/analyzer/core/idiom-data-access.ts",
      "src/analyzer/core/idiom-detector.ts",
      "src/analyzer/core/link-coverage.ts"
    ]
  }
}
