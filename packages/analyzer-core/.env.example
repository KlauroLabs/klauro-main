# AI Service Configuration

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORGANIZATION=org-your-org-id
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.3
OPENAI_RATE_LIMIT_RPM=50
OPENAI_RATE_LIMIT_TPM=40000

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_TEMPERATURE=0.3
ANTHROPIC_RATE_LIMIT_RPM=50
ANTHROPIC_RATE_LIMIT_TPM=100000

# HuggingFace Configuration (for fallback)
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key
HUGGINGFACE_MODEL=microsoft/codebert-base
HUGGINGFACE_ENDPOINT=https://api-inference.huggingface.co

# General AI Configuration
AI_TIMEOUT=30000
AI_MAX_RETRIES=3

# Cache Configuration
AI_CACHE_ENABLED=true
AI_CACHE_TTL=86400
AI_CACHE_MAX_SIZE=1000
AI_CACHE_PREFIX=ai:cache:

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Cost Tracking
AI_COST_TRACKING_ENABLED=true
AI_MAX_DAILY_COST=10
AI_MAX_MONTHLY_COST=100
AI_COST_ALERT_THRESHOLD=0.8

# Feature Flags
AI_FEATURE_CODE_ANALYSIS=true
AI_FEATURE_NL_DESCRIPTIONS=true
AI_FEATURE_RISK_ASSESSMENT=true
AI_FEATURE_ARCH_RECOMMENDATIONS=true
AI_FEATURE_SECURITY_ANALYSIS=true
AI_FEATURE_PERFORMANCE_ANALYSIS=true
AI_FEATURE_TEST_SUGGESTIONS=false
AI_FEATURE_DOC_GENERATION=false

# Fallback Configuration
AI_FALLBACK_ENABLED=true
AI_FALLBACK_STRATEGY=cascade
AI_FALLBACK_PROVIDERS=openai,anthropic,huggingface

# Prompt Configuration
AI_MAX_CONTEXT_LENGTH=8000
AI_INCLUDE_CODE_CONTEXT=true
AI_INCLUDE_ARCH_CONTEXT=true
AI_RESPONSE_FORMAT=structured