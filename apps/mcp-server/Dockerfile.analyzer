FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY apps/mcp-server/package*.json ./apps/mcp-server/
RUN cd apps/mcp-server && npm ci --legacy-peer-deps

COPY packages/analyzer-core/package*.json ./packages/analyzer-core/
RUN cd packages/analyzer-core && npm ci --legacy-peer-deps

COPY packages/analyzer-core ./packages/analyzer-core
COPY apps/mcp-server ./apps/mcp-server

WORKDIR /app/apps/mcp-server

ENV NODE_ENV=production
ENV KLAURO_REMOTE_ANALYZER_DATA=/data
ENV KLAURO_STORAGE_PATH=/data/storage
ENV KLAURO_ANALYZER_PORT=8787
ENV KLAURO_ANALYZER_RATE_LIMIT_PER_MINUTE=120
ENV NODE_PATH=/app/apps/mcp-server/node_modules

EXPOSE 8787

CMD ["npm", "run", "analyzer-server"]
