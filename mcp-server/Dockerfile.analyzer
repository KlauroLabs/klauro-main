FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY mcp-server/package*.json ./mcp-server/
RUN cd mcp-server && npm ci --legacy-peer-deps

COPY backend ./backend
COPY mcp-server ./mcp-server

WORKDIR /app/mcp-server

ENV NODE_ENV=production
ENV UNRAVL_REMOTE_ANALYZER_DATA=/data
ENV UNRAVL_STORAGE_PATH=/data/storage
ENV UNRAVL_ANALYZER_PORT=8787
ENV UNRAVL_ANALYZER_RATE_LIMIT_PER_MINUTE=120
ENV NODE_PATH=/app/mcp-server/node_modules

EXPOSE 8787

CMD ["npm", "run", "analyzer-server"]
