{
  "name": "@unravl/mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Unravl codebase analysis",
  "main": "src/index.ts",
  "bin": {
    "unravl": "src/cli.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "agent-start": "tsx src/cli.ts agent-start",
    "agent-work-packet": "tsx src/cli.ts agent-work-packet",
    "agent-install": "tsx src/cli.ts agent-install",
    "doctor": "tsx src/cli.ts doctor",
    "save-golden": "tsx src/cli.ts save-golden",
    "gauntlet": "tsx src/gauntlet.ts",
    "answer-gauntlet": "tsx src/answer-gauntlet.ts",
    "agent-gauntlet": "tsx src/agent-gauntlet.ts",
    "agent-benchmark": "tsx src/agent-benchmark.ts",
    "agentic-benchmark": "tsx src/agent-benchmark.ts --agentic",
    "agentic-benchmark-suite": "tsx src/agent-benchmark.ts --agentic --suite --real-repos --no-fixtures --max-targets 6 --max-tasks-per-repo 8",
    "agent-quality-benchmark": "tsx src/agent-quality-benchmark.ts --real-repos --max-targets 6 --max-tasks-per-repo 8",
    "agent-live-benchmark": "tsx src/agent-quality-benchmark.ts --live",
    "agent-vision-acceptance": "tsx src/agent-vision-acceptance.ts",
    "agent-proof-full": "npm run typecheck && npm test && npm run analysis-gauntlet && npm run agent-gauntlet && npm run vision-gauntlet && npm run agentic-benchmark-suite && npm run agent-quality-benchmark && npm run incremental-benchmark && npm run agent-vision-acceptance",
    "incremental-benchmark": "tsx src/incremental-benchmark.ts",
    "analysis-gauntlet": "tsx src/analysis-gauntlet.ts",
    "contract-gauntlet": "tsx src/contract-gauntlet.ts",
    "vision-gauntlet": "tsx src/vision-gauntlet.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@typescript-eslint/typescript-estree": "^8.43.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "espree": "^10.4.0",
    "estraverse": "^5.3.0",
    "fs-extra": "^11.3.1",
    "glob": "^11.0.3",
    "java-parser": "^3.0.1",
    "js-yaml": "^4.1.0",
    "p-limit": "^3.1.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-rust": "^0.24.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  }
}
