{
	email mike.shattuck@klauro.com
}

app.klauro.com {
	encode gzip zstd
	root * /srv/app

	# Same-origin API proxy: forward /api/* straight to the api container
	# instead of letting it fall through to the SPA's try_files fallback.
	# Defense in depth: the SPA's API base is inlined at BUILD time; any build
	# that ships without it falls back to window.location.origin, and without
	# this block that request would match nothing under /srv/app and fall
	# through to /index.html with HTTP 200 — the frontend then silently parses
	# an HTML document as the JSON response (observed live). A dedicated
	# handle for /api/* removes the SPA fallback as a possible outcome for
	# API paths regardless of what the JS bundle does. Uses the same
	# `dynamic a` upstream as mcp.klauro.com (see the defect note below) so
	# container recreates are picked up without a caddy restart.
	@api path /api/*
	handle @api {
		reverse_proxy {
			dynamic a {
				name api
				port 8787
				resolvers 127.0.0.11
				refresh 5s
			}
		}
	}

	# Vite emits content-hashed filenames under /assets (index-<hash>.js), so
	# those are immutable and can be cached hard.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The SPA shell (index.html) must NEVER be cached: it references the current
	# hashed bundle, so a stale index.html pins the browser to an OLD app after a
	# deploy. This was the real "the app looks broken / I can't use it" bug —
	# browsers held yesterday's index.html. Always revalidate it.
	@html path / /index.html
	header @html Cache-Control "no-cache, no-store, must-revalidate"

	handle {
		try_files {path} /index.html
		file_server
	}
}

mcp.klauro.com {
	encode gzip zstd

	@fabric path /v1/coordination/*
	handle @fabric {
		reverse_proxy {
			dynamic a {
				name fabric
				port 8788
				resolvers 127.0.0.11
				refresh 5s
			}
		}
	}

	# Defect #24: a plain `reverse_proxy api:8787` resolves the `api` hostname to
	# a container IP ONCE (at config load / first dial) and then reuses that
	# address+pooled connections. Every deploy recreates the `api` container
	# (`docker compose up -d --build`), which gets a NEW IP from Docker's
	# embedded DNS (127.0.0.11) — but Caddy's static upstream had cached the
	# OLD one. The old IP is unowned on the bridge network, so requests to it
	# hang (no RST) rather than fail fast -> Cloudflare eventually reports 524,
	# even though the new api container is perfectly healthy. `docker restart
	# klauro-caddy-1` "fixes" it only because a restart forces a fresh
	# resolution.
	#
	# Fix: `dynamic a` makes this a DYNAMIC upstream — Caddy re-resolves the
	# `api` name against Docker's embedded resolver on the refresh interval
	# below instead of caching a single address for the process lifetime, so a
	# container recreate is picked up within seconds instead of requiring a
	# manual/blunt caddy restart.
	handle {
		reverse_proxy {
			dynamic a {
				name api
				port 8787
				resolvers 127.0.0.11
				refresh 5s
			}
		}
	}
}
