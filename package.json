{
  "name": "@klauro/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Klauro monorepo for CAS analysis, MCP agent context, hosted analyzers, and legacy product reference surfaces.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "legacy/*"
  ],
  "scripts": {
    "deploy": "bash infrastructure/vps/deploy.sh",
    "app:dev": "npm --prefix apps/app run dev",
    "app:build": "npm --prefix apps/app run build",
    "app:typecheck": "npm --prefix apps/app run typecheck",
    "api:dev": "npm --prefix apps/api run dev",
    "api:build": "npm --prefix apps/api run build",
    "api:typecheck": "npm --prefix apps/api run typecheck",
    "mcp:typecheck": "npm --prefix apps/mcp-server run typecheck",
    "mcp:test": "npm --prefix apps/mcp-server test",
    "analyzer:build": "npm --prefix packages/analyzer-core run build",
    "analyzer:test": "npm --prefix packages/analyzer-core test",
    "proof": "npm run mcp:typecheck && npm run mcp:test && npm run analyzer:build && npm run analyzer:test"
  },
  "license": "UNLICENSED"
}
