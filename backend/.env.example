# =============================================================================
# UNRAVL BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and update the values for your environment
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database connection details
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=unravl_dev
DATABASE_USER=unravl_user
DATABASE_PASSWORD=unravl_password_change_me

# Enable SSL connection (set to true for production)
DATABASE_SSL=false

# Connection pool settings (optimized for development)
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=50
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_POOL_CONNECTION_TIMEOUT=60000
DATABASE_POOL_ACQUIRE_TIMEOUT=60000
DATABASE_POOL_MAX_USES=7500

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server settings
PORT=3000
HOST=localhost
NODE_ENV=development

# CORS settings
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT configuration
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# Session settings
SESSION_SECRET=your-super-secure-session-secret-change-this-too
SESSION_MAX_AGE=86400000

# API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Message queue (optional)
RABBITMQ_URL=amqp://localhost:5672

# =============================================================================
# TELEMETRY AND MONITORING
# =============================================================================

# Telemetry settings
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=100
TELEMETRY_FLUSH_INTERVAL=5000

# Health check settings
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# REPOSITORY ANALYSIS SETTINGS
# =============================================================================

# GitHub integration
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# GitLab integration  
GITLAB_CLIENT_ID=your-gitlab-app-client-id
GITLAB_CLIENT_SECRET=your-gitlab-app-client-secret

# Analysis settings
ANALYSIS_TIMEOUT=300000
ANALYSIS_MAX_FILE_SIZE=10485760
ANALYSIS_MAX_FILES=10000

# =============================================================================
# AI INTEGRATION (OPTIONAL)
# =============================================================================

# OpenAI configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Claude configuration
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# =============================================================================
# EMAIL NOTIFICATIONS
# =============================================================================

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Unravl <noreply@unravl.dev>

# =============================================================================
# FILE STORAGE
# =============================================================================

# Local storage settings
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# AWS S3 settings (if using S3)
# STORAGE_TYPE=s3
# AWS_REGION=us-west-2
# AWS_BUCKET=unravl-storage
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# =============================================================================
# LOGGING
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log format (json, simple)
LOG_FORMAT=simple

# Log to file
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable development features
DEV_MODE=true
DEV_ENABLE_CORS=true
DEV_ENABLE_LOGS=true

# Mock external services
MOCK_GITHUB_API=false
MOCK_AI_SERVICES=false
MOCK_EMAIL_SERVICE=true

# Seed data
AUTO_LOAD_SEED_DATA=false

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# Production-specific settings (uncomment for production)
# NODE_ENV=production
# DATABASE_SSL=true
# JWT_SECRET=generate-a-very-secure-random-string-for-production
# SESSION_SECRET=generate-another-very-secure-random-string
# LOG_LEVEL=warn
# LOG_FORMAT=json
# DEV_MODE=false
# TELEMETRY_ENABLED=true

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Application monitoring
APM_ENABLED=false
APM_SERVICE_NAME=unravl-backend
APM_ENVIRONMENT=development

# Metrics collection
METRICS_ENABLED=true
METRICS_PORT=9090

# Error tracking (Sentry, etc.)
ERROR_TRACKING_ENABLED=false
SENTRY_DSN=your-sentry-dsn

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature toggles
FEATURE_AI_ANALYSIS=true
FEATURE_REALTIME_COLLABORATION=false
FEATURE_ADVANCED_VISUALIZATIONS=true
FEATURE_CUSTOM_INTEGRATIONS=false

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit .env files to version control
# 2. Use strong, unique secrets for production
# 3. Set DATABASE_SSL=true for production databases
# 4. Configure proper CORS origins for production
# 5. Use environment-specific values for external services
# 6. Enable monitoring and logging in production
# 7. Set appropriate rate limits based on your infrastructure