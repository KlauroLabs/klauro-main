# =============================================================================
# UNRAVL PLATFORM ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=unravl
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here
DATABASE_SSL=false

# Database Pool Configuration
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=50
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_POOL_CONNECTION_TIMEOUT=60000
DATABASE_POOL_ACQUIRE_TIMEOUT=60000
DATABASE_POOL_MAX_USES=7500

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=unravl
JWT_AUDIENCE=unravl-api

# Password Security
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# Session Security
TOKEN_BLACKLIST_TTL=86400
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/oauth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/oauth/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3001/api/auth/oauth/microsoft/callback

# GitLab OAuth
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_CALLBACK_URL=http://localhost:3001/api/auth/oauth/gitlab/callback

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Cookie Configuration
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# =============================================================================
# EMAIL CONFIGURATION (Future Implementation)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@unravl.io

# =============================================================================
# REDIS CONFIGURATION (Future Implementation)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# MONITORING & ANALYTICS (Future Implementation)
# =============================================================================
SENTRY_DSN=
LOG_LEVEL=info
ANALYTICS_ENABLED=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_OAUTH=true
ENABLE_2FA=false
ENABLE_API_KEYS=true
ENABLE_WEBHOOKS=false
ENABLE_BILLING=false

# =============================================================================
# TELEMETRY CONFIGURATION
# =============================================================================
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=100
TELEMETRY_FLUSH_INTERVAL=10000

# =============================================================================
# ANALYZER CONFIGURATION
# =============================================================================
ANALYZER_MAX_FILE_SIZE=10485760
ANALYZER_TIMEOUT=300000
ANALYZER_PARALLEL_PROCESSING=true
ANALYZER_CACHE_ENABLED=true