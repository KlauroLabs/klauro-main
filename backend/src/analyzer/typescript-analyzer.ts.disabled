// TypeScript/JavaScript Analyzer - Detects multiple frameworks within TypeScript/JS codebases
// Supports: NestJS, Express, React, Next.js, Node.js, and more

import { BaseAnalyzer, AnalyzerOptions, LanguageDetection, FrameworkDetection, ComponentDiscovery } from './base-analyzer';
import { ComponentNode, ComponentType, Connection, RiskArea, ComponentMetadata } from '../types';
import { parse } from '@typescript-eslint/typescript-estree';
import * as path from 'path';

interface TypeScriptAnalysisContext {
  ast: any;
  content: string;
  filePath: string;
  imports: string[];
  exports: string[];
  decorators: string[];
  classes: string[];
  functions: string[];
  interfaces: string[];
}

export class TypeScriptAnalyzer extends BaseAnalyzer {
  private frameworkPatterns = {
    nestjs: {
      patterns: ['@Controller', '@Injectable', '@Module', '@Get', '@Post', '@Put', '@Delete'],
      dependencies: ['@nestjs/core', '@nestjs/common'],
      confidence: 0.9
    },
    express: {
      patterns: ['express()', 'app.get', 'app.post', 'app.use', 'router.'],
      dependencies: ['express'],
      confidence: 0.8
    },
    react: {
      patterns: ['React.Component', 'useState', 'useEffect', 'JSX.Element'],
      dependencies: ['react', 'react-dom'],
      confidence: 0.9
    },
    nextjs: {
      patterns: ['getServerSideProps', 'getStaticProps', 'NextPage', 'pages/'],
      dependencies: ['next'],
      confidence: 0.9
    },
    fastify: {
      patterns: ['fastify()', '.register', '.get', '.post'],
      dependencies: ['fastify'],
      confidence: 0.8
    }
  };

  getAnalyzerName(): string {
    return 'TypeScript/JavaScript Analyzer';
  }

  getSupportedLanguages(): string[] {
    return ['typescript', 'javascript'];
  }

  getSupportedFrameworks(): string[] {
    return ['nestjs', 'express', 'react', 'nextjs', 'fastify', 'nodejs'];
  }

  protected async detectLanguageAndFramework(): Promise<LanguageDetection> {
    console.log('🔍 Detecting TypeScript/JavaScript project...');

    // Check for TypeScript/JavaScript files
    const tsFiles = await this.findFiles([
      '**/*.ts', '**/*.tsx', '**/*.js', '**/*.jsx'
    ], [
      'node_modules/**', 'dist/**', 'build/**', '**/*.d.ts', '**/*.test.*', '**/*.spec.*'
    ]);

    if (tsFiles.length === 0) {
      return { language: 'unknown', confidence: 0, frameworks: [], files: [] };
    }

    // Detect language type
    const hasTypeScript = tsFiles.some(f => f.endsWith('.ts') || f.endsWith('.tsx'));
    const language = hasTypeScript ? 'typescript' : 'javascript';
    
    console.log(`📝 Detected ${language} with ${tsFiles.length} files`);

    // Detect frameworks by analyzing package.json and code patterns
    const frameworks = await this.detectFrameworks(tsFiles);
    
    return {
      language,
      confidence: 0.95,
      frameworks,
      files: tsFiles
    };
  }

  private async detectFrameworks(files: string[]): Promise<FrameworkDetection[]> {
    const frameworks: FrameworkDetection[] = [];
    
    // Check package.json for dependencies
    const packageJson = await this.getPackageJson();
    const allDeps = {
      ...packageJson?.dependencies,
      ...packageJson?.devDependencies
    };

    // Sample some files for pattern analysis (don't analyze all for performance)
    const sampleFiles = files.slice(0, Math.min(50, files.length));
    let combinedContent = '';
    
    for (const file of sampleFiles) {
      try {
        const content = await this.readFile(file);
        combinedContent += content + '\n';
      } catch (error) {
        // Skip files that can't be read
        continue;
      }
    }

    // Analyze each framework
    for (const [frameworkName, config] of Object.entries(this.frameworkPatterns)) {
      let confidence = 0;
      let matchedPatterns: string[] = [];

      // Check dependency presence (40% of confidence)
      const depScore = config.dependencies.some(dep => allDeps[dep]) ? 0.4 : 0;
      
      // Check code patterns (60% of confidence)
      let patternScore = 0;
      for (const pattern of config.patterns) {
        if (combinedContent.includes(pattern)) {
          patternScore += 0.6 / config.patterns.length;
          matchedPatterns.push(pattern);
        }
      }

      confidence = depScore + patternScore;

      if (confidence > 0.3) { // Threshold for framework detection
        frameworks.push({
          name: frameworkName,
          version: allDeps[config.dependencies[0]] || 'unknown',
          confidence,
          patterns: matchedPatterns
        });
      }
    }

    // Sort by confidence
    frameworks.sort((a, b) => b.confidence - a.confidence);
    
    console.log(`🎯 Detected frameworks: ${frameworks.map(f => `${f.name}(${(f.confidence * 100).toFixed(0)}%)`).join(', ')}`);
    
    return frameworks;
  }

  private async getPackageJson(): Promise<any> {
    try {
      const packagePath = path.join(this.projectPath, 'package.json');
      const fs = await import('fs-extra');
      return await fs.readJSON(packagePath);
    } catch {
      return null;
    }
  }

  protected async discoverComponents(): Promise<ComponentDiscovery> {
    console.log('🔍 Discovering TypeScript/JavaScript components...');

    const files = await this.findFiles([
      '**/*.ts', '**/*.tsx', '**/*.js', '**/*.jsx'
    ], [
      'node_modules/**', 'dist/**', 'build/**', 'coverage/**',
      '**/*.d.ts', '**/*.test.*', '**/*.spec.*', '**/*.stories.*'
    ]);

    const components: ComponentNode[] = [];
    let analyzedCount = 0;
    let skippedCount = 0;

    console.log(`📁 Processing ${files.length} TypeScript/JavaScript files...`);

    for (const file of files) {
      try {
        const component = await this.analyzeFile(file);
        if (component) {
          components.push(component);
          analyzedCount++;
        } else {
          skippedCount++;
        }
      } catch (error) {
        console.warn(`⚠️ Could not analyze ${path.relative(this.projectPath, file)}: ${error}`);
        skippedCount++;
      }
    }

    return {
      totalFiles: files.length,
      analyzedFiles: analyzedCount,
      skippedFiles: skippedCount,
      components
    };
  }

  private async analyzeFile(filePath: string): Promise<ComponentNode | null> {
    const content = await this.readFile(filePath);
    const relativePath = path.relative(this.projectPath, filePath);
    
    // Parse TypeScript/JavaScript with proper options
    let ast;
    try {
      ast = parse(content, {
        loc: true,
        range: true,
        jsx: true,
        allowImportExportEverywhere: true,
        ecmaFeatures: {
          jsx: true,
          globalReturn: true
        }
      });
    } catch (error) {
      // If TypeScript parsing fails, this might be a complex file - try basic analysis
      return this.createBasicComponent(filePath, content);
    }

    // Extract detailed information from AST
    const context = this.extractAnalysisContext(ast, content, filePath);
    
    // Determine component type based on patterns and file structure
    const componentType = this.determineComponentType(relativePath, context);
    
    // Create component metadata
    const metadata = this.createComponentMetadata(content, context);

    return {
      id: this.generateComponentId(relativePath),
      name: path.basename(filePath, path.extname(filePath)),
      type: componentType,
      path: relativePath,
      dependencies: context.imports,
      dependents: [], // Will be populated during connection analysis
      metadata
    };
  }

  private extractAnalysisContext(ast: any, content: string, filePath: string): TypeScriptAnalysisContext {
    const context: TypeScriptAnalysisContext = {
      ast,
      content,
      filePath,
      imports: [],
      exports: [],
      decorators: [],
      classes: [],
      functions: [],
      interfaces: []
    };

    // Traverse AST to extract information
    this.traverseAST(ast, context);
    
    return context;
  }

  private traverseAST(node: any, context: TypeScriptAnalysisContext) {
    if (!node) return;

    try {
      switch (node.type) {
        case 'ImportDeclaration':
          if (node.source?.value) {
            context.imports.push(node.source.value);
          }
          break;
          
        case 'ExportDefaultDeclaration':
        case 'ExportNamedDeclaration':
          if (node.declaration?.id?.name) {
            context.exports.push(node.declaration.id.name);
          }
          break;
          
        case 'Decorator':
          if (node.expression?.name) {
            context.decorators.push(node.expression.name);
          } else if (node.expression?.callee?.name) {
            context.decorators.push(node.expression.callee.name);
          }
          break;
          
        case 'ClassDeclaration':
          if (node.id?.name) {
            context.classes.push(node.id.name);
          }
          break;
          
        case 'FunctionDeclaration':
        case 'ArrowFunctionExpression':
          if (node.id?.name) {
            context.functions.push(node.id.name);
          }
          break;
          
        case 'TSInterfaceDeclaration':
          if (node.id?.name) {
            context.interfaces.push(node.id.name);
          }
          break;
      }

      // Recursively traverse child nodes
      for (const key in node) {
        const child = node[key];
        if (Array.isArray(child)) {
          child.forEach(item => this.traverseAST(item, context));
        } else if (child && typeof child === 'object') {
          this.traverseAST(child, context);
        }
      }
    } catch (error) {
      // Skip problematic nodes
    }
  }

  private determineComponentType(filePath: string, context: TypeScriptAnalysisContext): ComponentType {
    const pathLower = filePath.toLowerCase();
    const { decorators, functions, classes, interfaces } = context;

    // NestJS patterns
    if (decorators.some(d => ['Controller', 'Get', 'Post', 'Put', 'Delete'].includes(d))) {
      return 'route';
    }
    if (decorators.some(d => ['Injectable', 'Service'].includes(d))) {
      return 'service';
    }
    if (decorators.some(d => ['Module'].includes(d))) {
      return 'config';
    }
    if (decorators.some(d => ['Guard', 'Interceptor', 'Middleware'].includes(d))) {
      return 'middleware';
    }

    // Express patterns
    if (context.content.includes('express()') && context.content.includes('app.listen')) {
      return 'route'; // Main app file
    }
    if (pathLower.includes('route') || pathLower.includes('router')) {
      return 'route';
    }
    if (pathLower.includes('middleware')) {
      return 'middleware';
    }

    // React patterns
    if (context.content.includes('JSX') || context.content.includes('React.Component')) {
      return 'service'; // React components mapped to service
    }

    // File path based classification
    if (pathLower.includes('controller')) return 'controller';
    if (pathLower.includes('service')) return 'service';
    if (pathLower.includes('model') || pathLower.includes('entity')) return 'model';
    if (pathLower.includes('config') || pathLower.includes('setting')) return 'config';
    if (pathLower.includes('util') || pathLower.includes('helper')) return 'utility';
    if (pathLower.includes('test') || pathLower.includes('spec')) return 'utility';

    // Content-based classification
    if (interfaces.length > classes.length && functions.length === 0) return 'model';
    if (classes.length > 0) return 'service';
    if (functions.length > 0 && classes.length === 0) return 'utility';

    return 'service'; // Default fallback
  }

  private createBasicComponent(filePath: string, content: string): ComponentNode {
    const relativePath = path.relative(this.projectPath, filePath);
    
    return {
      id: this.generateComponentId(relativePath),
      name: path.basename(filePath, path.extname(filePath)),
      type: 'service', // Default type for unparseable files
      path: relativePath,
      dependencies: this.extractBasicImports(content),
      dependents: [],
      metadata: {
        lineCount: content.split('\n').length,
        complexity: this.calculateComplexity(content),
        lastModified: new Date().toISOString(),
        exports: [],
        imports: this.extractBasicImports(content),
        isEntry: false,
        isOrphaned: false
      }
    };
  }

  private extractBasicImports(content: string): string[] {
    const imports: string[] = [];
    
    // Match import statements
    const importRegex = /(?:import.*from\s+['"`]([^'"`]+)['"`]|require\s*\(\s*['"`]([^'"`]+)['"`]\))/g;
    let match;
    
    while ((match = importRegex.exec(content)) !== null) {
      const importPath = match[1] || match[2];
      if (importPath && !importPath.startsWith('.') && !importPath.startsWith('/')) {
        imports.push(importPath);
      }
    }
    
    return imports;
  }

  private createComponentMetadata(content: string, context: TypeScriptAnalysisContext): ComponentMetadata {
    const lines = content.split('\n');
    
    return {
      lineCount: lines.length,
      complexity: this.calculateComplexity(content),
      lastModified: new Date().toISOString(),
      exports: context.exports,
      imports: context.imports,
      isEntry: this.isEntryPoint(context),
      isOrphaned: false // Will be determined later
    };
  }

  private isEntryPoint(context: TypeScriptAnalysisContext): boolean {
    const { content, filePath } = context;
    
    // Check common entry point patterns
    return (
      filePath.includes('main.ts') ||
      filePath.includes('index.ts') ||
      filePath.includes('app.ts') ||
      content.includes('app.listen') ||
      content.includes('bootstrap') ||
      content.includes('NestFactory.create')
    );
  }

  protected async analyzeConnections(components: ComponentNode[]): Promise<Connection[]> {
    console.log('🔗 Analyzing component connections...');
    
    const connections: Connection[] = [];
    const componentMap = new Map<string, ComponentNode>();
    
    // Index components by path for quick lookup
    components.forEach(comp => {
      componentMap.set(comp.path, comp);
    });

    // Build connections based on imports
    for (const component of components) {
      for (const importPath of component.metadata.imports) {
        // Try to resolve import to actual component
        const targetComponent = this.resolveImport(importPath, component.path, componentMap);
        
        if (targetComponent) {
          // Add dependency
          if (!component.dependencies.includes(targetComponent.id)) {
            component.dependencies.push(targetComponent.id);
          }
          
          // Add dependent
          if (!targetComponent.dependents.includes(component.id)) {
            targetComponent.dependents.push(component.id);
          }
          
          // Create connection
          connections.push({
            from: component.id,
            to: targetComponent.id,
            type: 'import',
            weight: 1,
            metadata: {
              callSites: 1,
              dataFlow: 'import'
            }
          });
        }
      }
    }

    return connections;
  }

  private resolveImport(importPath: string, fromPath: string, componentMap: Map<string, ComponentNode>): ComponentNode | null {
    // Handle relative imports
    if (importPath.startsWith('.')) {
      const resolvedPath = path.resolve(path.dirname(fromPath), importPath);
      const extensions = ['.ts', '.tsx', '.js', '.jsx', '/index.ts', '/index.js'];
      
      for (const ext of extensions) {
        const testPath = resolvedPath + ext;
        const component = componentMap.get(testPath);
        if (component) return component;
      }
    }
    
    return null; // External dependency or unresolvable
  }

  protected async identifyEntryPoints(components: ComponentNode[]): Promise<string[]> {
    return components
      .filter(comp => comp.metadata.isEntry)
      .map(comp => comp.id);
  }

  protected async assessRisks(components: ComponentNode[], connections: Connection[]): Promise<RiskArea[]> {
    const risks: RiskArea[] = [];

    for (const component of components) {
      const reasons: string[] = [];
      let riskLevel: 'low' | 'medium' | 'high' = 'low';

      // High complexity
      if (component.metadata.complexity > 7) {
        reasons.push(`High complexity (${component.metadata.complexity}/10)`);
        riskLevel = 'high';
      } else if (component.metadata.complexity > 5) {
        reasons.push(`Medium complexity (${component.metadata.complexity}/10)`);
        riskLevel = riskLevel === 'low' ? 'medium' : riskLevel;
      }

      // Large files
      if (component.metadata.lineCount > 500) {
        reasons.push(`Large file (${component.metadata.lineCount} lines)`);
        riskLevel = component.metadata.lineCount > 1000 ? 'high' : 'medium';
      }

      // Too many dependencies
      if (component.dependencies.length > 15) {
        reasons.push(`Many dependencies (${component.dependencies.length})`);
        riskLevel = 'high';
      }

      // Critical path components
      if (component.dependents.length > 10) {
        reasons.push(`Critical component (${component.dependents.length} dependents)`);
        riskLevel = component.dependents.length > 20 ? 'high' : 'medium';
      }

      if (reasons.length > 0) {
        risks.push({
          componentId: component.id,
          riskLevel,
          reasons,
          impact: component.dependents.length > 0 ? 
            `Changes could affect ${component.dependents.length} components` :
            'Isolated component risk'
        });
      }
    }

    return risks;
  }
}