#!/usr/bin/env ts-node

/**
 * Integration Test for AI System
 * Tests all components of the AI Integration Layer
 */

import { AIService } from './ai-service';
import { AIAnalyzer } from './ai-analyzer';
import { AICache } from './ai-cache';
import { ComponentNode, ArchitectureBlueprint } from '../types';

async function runIntegrationTest() {
  console.log('🧪 Starting AI Integration Layer Test Suite\n');
  
  let passedTests = 0;
  let failedTests = 0;

  // Test 1: AI Service Initialization
  console.log('Test 1: AI Service Initialization');
  try {
    const aiService = AIService.getInstance();
    console.log('✅ AI Service initialized successfully');
    console.log(`   - Available providers: ${aiService['providers'].map(p => p.name).join(', ')}`);
    passedTests++;
  } catch (error) {
    console.log('❌ Failed to initialize AI Service:', error);
    failedTests++;
  }

  // Test 2: Cache System
  console.log('\nTest 2: Cache System');
  try {
    const cache = AICache.getInstance();
    const testKey = 'test:integration';
    const testValue = { test: 'data', timestamp: Date.now() };
    
    await cache.set(testKey, testValue, 60);
    const retrieved = await cache.get(testKey);
    
    if (retrieved && retrieved.test === 'data') {
      console.log('✅ Cache system working correctly');
      console.log(`   - Stored and retrieved test data successfully`);
      passedTests++;
    } else {
      throw new Error('Cache retrieval mismatch');
    }
  } catch (error) {
    console.log('❌ Cache system error:', error);
    failedTests++;
  }

  // Test 3: Component Description Generation
  console.log('\nTest 3: Component Description Generation');
  try {
    const aiService = AIService.getInstance();
    const testComponent: ComponentNode = {
      id: 'test-component',
      name: 'UserAuthService',
      type: 'service',
      path: '/src/services/auth.ts',
      dependencies: ['bcrypt', 'jsonwebtoken'],
      dependents: ['UserController'],
      metadata: {
        lineCount: 250,
        complexity: 8,
        lastModified: new Date(),
        exports: ['authenticate', 'authorize', 'refreshToken'],
        imports: ['User', 'Token'],
        layer: 'business',
        responsibilities: ['Authentication', 'Authorization', 'Token Management']
      }
    };

    const description = await aiService.generateComponentDescription(testComponent);
    console.log('✅ Component description generated');
    console.log(`   - Description: "${description.substring(0, 100)}..."`);
    passedTests++;
  } catch (error) {
    console.log('❌ Description generation failed:', error);
    failedTests++;
  }

  // Test 4: Risk Assessment
  console.log('\nTest 4: Risk Assessment');
  try {
    const aiService = AIService.getInstance();
    const testCode = `
      function processPayment(amount, cardNumber) {
        console.log('Processing payment:', cardNumber);
        const result = eval('amount * 1.1');
        return result;
      }
    `;

    const risks = await aiService.assessRisks(testCode, 'javascript');
    console.log('✅ Risk assessment completed');
    console.log(`   - Found ${risks.length} risk(s)`);
    if (risks.length > 0) {
      console.log(`   - Top risk: ${risks[0].type} - ${risks[0].description.substring(0, 50)}...`);
    }
    passedTests++;
  } catch (error) {
    console.log('❌ Risk assessment failed:', error);
    failedTests++;
  }

  // Test 5: Code Analysis
  console.log('\nTest 5: Code Analysis');
  try {
    const aiService = AIService.getInstance();
    const testCode = `
      async function fetchUserData(userId) {
        try {
          const response = await fetch(\`/api/users/\${userId}\`);
          const data = await response.json();
          return data;
        } catch (error) {
          console.error('Failed to fetch user:', error);
          return null;
        }
      }
    `;

    const analysis = await aiService.analyzeCode(testCode, 'typescript');
    console.log('✅ Code analysis completed');
    console.log(`   - Complexity: ${analysis.complexity}`);
    console.log(`   - Quality score: ${analysis.qualityScore}/10`);
    console.log(`   - Patterns found: ${analysis.patterns.length}`);
    passedTests++;
  } catch (error) {
    console.log('❌ Code analysis failed:', error);
    failedTests++;
  }

  // Test 6: AI Analyzer Integration
  console.log('\nTest 6: AI Analyzer Integration');
  try {
    const aiAnalyzer = new AIAnalyzer();
    const testBlueprint: ArchitectureBlueprint = {
      projectName: 'test-project',
      framework: 'express',
      components: [{
        id: 'api-gateway',
        name: 'APIGateway',
        type: 'controller',
        path: '/src/gateway.ts',
        dependencies: ['express', 'cors'],
        dependents: [],
        metadata: {
          lineCount: 500,
          complexity: 12,
          lastModified: new Date(),
          exports: ['router'],
          imports: ['middleware'],
          layer: 'presentation',
          responsibilities: ['Request routing', 'Response handling']
        }
      }],
      connections: [],
      entryPoints: [],
      exitPoints: [],
      orphanedComponents: [],
      riskAreas: [],
      metadata: {
        totalComponents: 1,
        frameworkVersion: '4.18.0',
        analysisDate: new Date(),
        repositoryPath: '/test',
        entryPointsCount: 0,
        orphanedCount: 0,
        complexityAverage: 12,
        primaryLanguage: 'typescript',
        languageDistribution: { typescript: 100 },
        codebaseSize: {
          totalLines: 500,
          codeLines: 400,
          commentLines: 50,
          blankLines: 50
        }
      },
      technologyStack: {
        primaryFramework: {
          name: 'express',
          version: '4.18.0',
          type: 'web' as const,
          usage: 'primary' as const,
          conventions: [],
          patterns: [],
          detectionConfidence: 1
        },
        additionalFrameworks: [],
        languages: [],
        buildTools: [],
        testingFrameworks: [],
        databases: [],
        messageQueues: [],
        caching: [],
        authentication: [],
        deployment: []
      },
      dependencies: {
        totalCount: 2,
        directDependencies: [],
        devDependencies: [],
        peerDependencies: [],
        vulnerabilities: [],
        outdated: [],
        unused: [],
        licenseCompliance: []
      },
      apiEndpoints: [],
      securityAnalysis: {
        vulnerabilities: [],
        authenticationMethods: [],
        authorizationPatterns: [],
        dataEncryption: [],
        inputValidation: [],
        securityHeaders: [],
        secrets: []
      },
      testingInfo: {
        frameworks: [],
        coverage: {
          overall: 0,
          lines: { covered: 0, total: 0, percentage: 0 },
          branches: { covered: 0, total: 0, percentage: 0 },
          functions: { covered: 0, total: 0, percentage: 0 },
          statements: { covered: 0, total: 0, percentage: 0 },
          byComponent: {},
          byType: {},
          uncoveredFiles: []
        },
        testTypes: [],
        testFiles: [],
        totalTests: 0,
        passingTests: 0,
        failingTests: 0,
        skippedTests: 0,
        testSuites: []
      },
      deploymentInfo: {
        platform: 'unknown',
        containerization: { type: 'none' },
        cicd: {
          platform: 'unknown',
          configFile: '',
          stages: [],
          deploymentStrategy: '',
          automated: false
        },
        monitoring: {
          tools: [],
          metrics: [],
          logging: {
            level: 'info',
            destination: 'stdout',
            structured: false,
            aggregation: false
          },
          alerting: {
            platform: 'none',
            rules: [],
            channels: []
          }
        },
        scaling: {
          type: 'vertical',
          automatic: false,
          metrics: [],
          limits: {
            minInstances: 1,
            maxInstances: 1,
            cpu: '1',
            memory: '512Mi'
          }
        }
      }
    };

    const enhanced = await aiAnalyzer.enhanceBlueprint(testBlueprint);
    console.log('✅ Blueprint enhancement completed');
    
    const hasAIEnhancements = enhanced.components.some(c => 
      c.metadata.aiDescription || 
      c.metadata.aiRiskAssessment || 
      c.metadata.aiRecommendations
    );
    
    if (hasAIEnhancements) {
      console.log('   - AI enhancements successfully added to components');
    }
    passedTests++;
  } catch (error) {
    console.log('❌ AI Analyzer integration failed:', error);
    failedTests++;
  }

  // Test 7: Usage Statistics
  console.log('\nTest 7: Usage Statistics');
  try {
    const aiService = AIService.getInstance();
    const stats = aiService.getUsageStatistics();
    console.log('✅ Usage statistics retrieved');
    console.log(`   - Total requests: ${stats.totalRequests}`);
    console.log(`   - Successful: ${stats.successfulRequests}`);
    console.log(`   - Failed: ${stats.failedRequests}`);
    console.log(`   - Cache hits: ${stats.cacheHits}`);
    console.log(`   - Providers used: ${Object.keys(stats.providerUsage).join(', ')}`);
    passedTests++;
  } catch (error) {
    console.log('❌ Usage statistics failed:', error);
    failedTests++;
  }

  // Final Report
  console.log('\n' + '='.repeat(60));
  console.log('📊 AI Integration Test Results');
  console.log('='.repeat(60));
  console.log(`✅ Passed: ${passedTests}/7 tests`);
  console.log(`❌ Failed: ${failedTests}/7 tests`);
  
  if (failedTests === 0) {
    console.log('\n🎉 All tests passed! AI Integration Layer is fully functional.');
  } else {
    console.log(`\n⚠️  ${failedTests} test(s) failed. Review the errors above.`);
  }

  return failedTests === 0;
}

// Run the tests
runIntegrationTest()
  .then(success => {
    process.exit(success ? 0 : 1);
  })
  .catch(error => {
    console.error('Test suite failed:', error);
    process.exit(1);
  });